# ════════════════════════════════════════════════════════
# CHAOS CREW v5 – Environment
# Kopiere diese Datei nach .env und passe Werte an
# ════════════════════════════════════════════════════════

# Streamerbot WebSocket (Windows-PC)
SB_HOST=192.168.178.39
SB_PORT=9090

# PostgreSQL
PG_DB=chaoscrew
PG_USER=chaoscrew
PG_PASSWORD=changeme_sichere_passwort

# Redis UI
REDIS_UI_USER=chaos
REDIS_UI_PASSWORD=changeme

# Domain (leer = nur HTTP Port 80)
DOMAIN=

# Caddy Config (Caddyfile = HTTP, Caddyfile.ssl = HTTPS)
CADDY_CONFIG=Caddyfile

# SSH Deployment (LXC Server)
SSH_HOST=192.168.178.34
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=changeme
SSH_DEPLOY_PATH=/opt/streamertools

# Twitch (Alerts-Service: Avatar-Lookup + Chatbefehle !wow/!followage/!ziele/!kraken)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kanal, dessen Chat gelesen und in den geantwortet wird (Login-Name)
TWITCH_CHANNEL=
# Leer = http://localhost:8080/alerts (Login über SSH-Tunnel, siehe CLAUDE.md)
PUBLIC_BASE_URL=
# Schützt /alerts/auth/login (?key=...)
ADMIN_TOKEN=
# Kraken-Verlosung: Ziel-Jahresgewinn in Euro
KRAKEN_TARGET=100000

# Claude API (Alerts-Service)
ANTHROPIC_KEY=
